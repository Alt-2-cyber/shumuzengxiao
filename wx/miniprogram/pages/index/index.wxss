.service-shortcuts { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin: 24rpx 0; }
.service-shortcuts button { min-width: 0; padding: 22rpx 18rpx; text-align: left; border-radius: 12rpx; border: 1rpx solid #496852; background: #1c3023; }
.service-shortcuts button:last-child { background: #20313a; border-color: #3e6773; }
.service-name { display: block; color: #e5f3e9; font-size: 30rpx; line-height: 1.5; font-weight: 700; }
.service-caption { display: block; margin-top: 8rpx; color: #b2c7b9; font-size: 23rpx; line-height: 1.5; }
.news-entry { display: block; width: 100%; text-align: left; padding: 24rpx 0; border-top: 1rpx solid #395346; border-bottom: 1rpx solid #395346; }
.news-entry-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: #b2e8ed; font-size: 29rpx; font-weight: 700; }
.news-entry-tip { display: block; margin-top: 12rpx; color: #b4c7b9; font-size: 24rpx; line-height: 1.6; }
.news-badge { color: #f0ce81; font-size: 22rpx; white-space: nowrap; }
.dashboard {
  width: 100%;
  background:
    linear-gradient(180deg, rgba(114, 227, 139, 0.08), transparent 260rpx),
    transparent;
}

.hero {
  min-height: 410rpx;
  padding: 34rpx;
}

.hero-glow {
  position: absolute;
  right: -120rpx;
  top: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114, 227, 139, 0.34), transparent 62%);
}

.hero-copy {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  color: #d4decf;
  font-size: 28rpx;
  line-height: 1.58;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.hero-actions .primary-btn,
.hero-actions .ghost-btn {
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.hero-actions .ghost-btn {
  border-color: rgba(247, 242, 222, 0.34);
  background: rgba(247, 242, 222, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  width: 100%;
  margin-top: 18rpx;
}

.metric {
  min-height: 128rpx;
  padding: 22rpx;
}

.metric-card:nth-child(3)::before {
  background: linear-gradient(120deg, transparent, rgba(240, 94, 73, 0.12), transparent);
}

.metric-note {
  color: #72e38b;
  font-size: 22rpx;
  font-weight: 800;
}

.latest-card {
  padding: 20rpx;
}

.latest-content {
  display: flex;
  gap: 22rpx;
}

.latest-image {
  width: 214rpx;
  height: 214rpx;
  flex: 0 0 214rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
}

.latest-body {
  flex: 1;
  min-width: 0;
}

.latest-top,
.device-head,
.alert-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.cow-id {
  color: #fff7df;
  font-size: 34rpx;
  font-weight: 900;
}

.latest-score {
  display: block;
  margin: 16rpx 0 8rpx;
  color: #72e38b;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 0.95;
}

.latest-time {
  display: block;
  margin-top: 12rpx;
  color: #758071;
  font-size: 22rpx;
}

.empty-btn {
  margin-top: 28rpx;
}

.device-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  width: 100%;
}

.device-card {
  min-width: 0;
  padding: 24rpx;
}

.device-name {
  flex: 1;
  min-width: 0;
  color: #fff7df;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

.device-type {
  display: block;
  margin-top: 16rpx;
  color: #aeb7a7;
  font-size: 24rpx;
}

.device-value {
  display: block;
  margin-top: 20rpx;
  color: #e5b85c;
  font-size: 32rpx;
  font-weight: 900;
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.alert-card {
  padding: 24rpx;
}

.alert-row {
  align-items: flex-start;
}

.alert-title {
  display: block;
  max-width: 430rpx;
  color: #fff7df;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.alert-meta {
  display: block;
  margin-top: 10rpx;
  color: #8f9b88;
  font-size: 22rpx;
  line-height: 1.35;
}

@media (max-width: 360px) {
  .hero {
    padding: 28rpx;
  }

  .hero-actions,
  .device-strip {
    grid-template-columns: 1fr;
  }

  .metric-grid {
    gap: 14rpx;
  }

  .latest-content {
    flex-direction: column;
  }

  .latest-image {
    width: 100%;
    height: 300rpx;
    flex-basis: auto;
  }

  .alert-title {
    max-width: 100%;
  }
}
