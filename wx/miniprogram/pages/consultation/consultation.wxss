@import "../../styles/support.wxss";
.urgent-note { display: block; margin-top: 18rpx; color: #f0b9a3; font-size: 25rpx; line-height: 1.7; }
.list-head { display: flex; align-items: center; justify-content: space-between; }
.consultation-row { display: block; width: 100%; padding: 28rpx 0; text-align: left; border-bottom: 1rpx solid #344a3b; }
.record-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.record-top .support-status { flex-shrink: 0; }
.record-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; line-height: 1.55; word-break: break-all; }
.record-excerpt { display: -webkit-box; margin-top: 16rpx; color: #bdccc2; font-size: 26rpx; line-height: 1.6; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-all; }
.detail-title { display: block; margin: 20rpx 0; font-size: 36rpx; line-height: 1.6; font-weight: 600; word-break: break-all; }
.record-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 18rpx; }
.record-tags .support-meta { margin: 0; }
.record-detail { padding-bottom: 28rpx; }
.detail-body { display: block; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
