page {
  min-height: 100vh;
  color: #f7f2de;
  background:
    radial-gradient(circle at 90% 0%, rgba(114, 227, 139, 0.22), transparent 420rpx),
    radial-gradient(circle at 0% 20%, rgba(229, 184, 92, 0.16), transparent 360rpx),
    linear-gradient(145deg, #07110b 0%, #111d14 56%, #061009 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
image,
scroll-view,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: 1.2;
}

button::after {
  border: 0;
}

image {
  display: block;
}

.page {
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  padding: 28rpx 30rpx 170rpx;
  overflow-x: hidden;
}

.eyebrow {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #72e38b;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.title {
  display: block;
  max-width: 100%;
  margin-top: 10rpx;
  color: #fff7df;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.04;
  letter-spacing: 0;
  word-break: keep-all;
}

.subtle {
  display: block;
  max-width: 100%;
  color: #aeb7a7;
  font-size: 26rpx;
  line-height: 1.55;
}

.card {
  width: 100%;
  max-width: 100%;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(247, 242, 222, 0.16);
  border-radius: 18rpx;
  background:
    linear-gradient(145deg, rgba(247, 242, 222, 0.1), rgba(247, 242, 222, 0.035)),
    rgba(9, 17, 12, 0.72);
  box-shadow: 0 30rpx 90rpx rgba(0, 0, 0, 0.22);
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(120deg, transparent, rgba(114, 227, 139, 0.12), transparent),
    repeating-linear-gradient(90deg, rgba(247, 242, 222, 0.06) 0 1rpx, transparent 1rpx 82rpx);
  opacity: 0.34;
}

.card-content {
  position: relative;
  z-index: 1;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #06100a;
  background: #72e38b;
  font-size: 22rpx;
  font-weight: 900;
}

.pill.normal {
  background: #72e38b;
}

.pill.observe {
  background: #d7ee8d;
}

.pill.warn {
  background: #e5b85c;
}

.pill.danger {
  color: #fff;
  background: #f05e49;
}

.pill.offline {
  color: #fff;
  background: #6e756d;
}

.primary-btn,
.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.primary-btn {
  color: #06100a;
  background: linear-gradient(135deg, #72e38b, #d7ee8d);
  box-shadow: 0 18rpx 46rpx rgba(114, 227, 139, 0.2);
}

.primary-btn[disabled] {
  opacity: 0.58;
}

.ghost-btn {
  border: 1rpx solid rgba(247, 242, 222, 0.24);
  color: #f7f2de;
  background: rgba(247, 242, 222, 0.08);
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 142rpx;
  padding: 24rpx;
}

.metric-label {
  color: #aeb7a7;
  font-size: 24rpx;
  font-weight: 800;
}

.metric-value {
  color: #fff7df;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  width: 100%;
  margin: 34rpx 0 18rpx;
}

.section-title {
  flex: 1;
  min-width: 0;
  color: #fff7df;
  font-size: 34rpx;
  font-weight: 900;
}

.section-head .subtle {
  flex: 0 1 240rpx;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #fff7df;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-text {
  display: block;
  margin-top: 14rpx;
  color: #aeb7a7;
  font-size: 26rpx;
  line-height: 1.5;
}
