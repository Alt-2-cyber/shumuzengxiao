.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 12rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(6, 16, 10, 0), rgba(6, 16, 10, 0.96) 28%),
    rgba(6, 16, 10, 0.9);
}

.tab-panel {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  min-height: 92rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(247, 242, 222, 0.14);
  border-radius: 28rpx;
  background: rgba(10, 24, 15, 0.94);
  box-shadow: 0 -18rpx 60rpx rgba(0, 0, 0, 0.32);
}

.tab-item {
  min-width: 0;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 20rpx;
  color: #aeb7a7;
  font-size: 22rpx;
  font-weight: 900;
}

.tab-item.active {
  color: #06100a;
  background: linear-gradient(135deg, #72e38b, #d7ee8d);
  box-shadow: 0 12rpx 32rpx rgba(114, 227, 139, 0.22);
}

.tab-icon {
  display: block;
  font-size: 26rpx;
  line-height: 1;
}

.tab-text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
